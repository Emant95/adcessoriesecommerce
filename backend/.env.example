# Local development settings for the API (copy to backend/.env)
DATABASE_URL=postgresql://adcessories:adcessories@localhost:5432/adcessories
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# First Super Admin, created by the seed script if it doesn't exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Store Owner
# Set to false to skip the sample categories and products
SEED_SAMPLE_DATA=true
