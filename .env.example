# Settings for docker-compose (copy to .env and change every secret)
POSTGRES_DB=adcessories
POSTGRES_USER=adcessories
POSTGRES_PASSWORD=change-me-db-password

# Long random string, e.g. from: openssl rand -hex 32
JWT_SECRET=change-me

# Public address of the site (used for CORS, sitemap and links)
PUBLIC_SITE_URL=http://localhost:8080
# Port the website is published on
WEB_PORT=8080
# Set to true once the site is served over HTTPS
COOKIE_SECURE=false

# First Super Admin (created on first start only; change the password after signing in)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Store Owner

# Load sample categories and products on first start (true/false)
SEED_SAMPLE_DATA=true
MAX_UPLOAD_MB=5
